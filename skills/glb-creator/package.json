{
  "name": "@asilvas/glb-creator",
  "version": "2.1.0",
  "description": "Bun GLB authoring, animation review and quality-guided delivery variants",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4-0"
  },
  "overrides": {
    "sharp": "0.34.5"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@headless-three/renderer": "0.4.5",
    "three": "0.184.0",
    "sharp": "0.34.5",
    "gltf-validator": "2.0.0-dev.3.10",
    "@gltf-transform/extensions": "4.5.1",
    "meshoptimizer": "1.3.0"
  },
  "exports": {
    ".": "./scripts/index.ts",
    "./geometry": "./scripts/geometry.ts",
    "./preview": "./scripts/preview.ts",
    "./validate": "./scripts/validate.ts",
    "./variants": "./scripts/variants.ts",
    "./optimize": "./scripts/optimize.ts",
    "./review": "./scripts/review.ts",
    "./review-viewer": "./scripts/review-viewer.ts",
    "./decode": "./scripts/decode.ts",
    "./quality-metric": "./scripts/quality-metric.ts"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "preview": "bun scripts/preview.ts",
    "frame": "bun scripts/frame.ts",
    "clean": "bun scripts/clean.ts",
    "check": "bun scripts/skill-check.ts",
    "test": "bun test ./tests/core.test.ts ./tests/cleanup.test.ts ./tests/optimization.test.ts ./tests/variants.test.ts ./tests/review.test.ts ./tests/optimize.test.ts ./tests/quality-metric.test.ts ./tests/animation-preview.test.ts ./tests/content-aware.test.ts ./tests/release.test.ts",
    "variants": "bun scripts/variants.ts",
    "optimize": "bun scripts/optimize.ts",
    "review": "bun scripts/review.ts",
    "decode": "bun scripts/decode.ts",
    "test:smoke": "bun tests/delivery-smoke.ts"
  }
}
